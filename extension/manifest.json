{
  "manifest_version": 3,
  "name": "Demo Director",
  "version": "0.1.0",
  "description": "Stage-manage live demos: veil parts of the page, then reveal them on cue from a Stream Deck or hotkey.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://*.app.github.dev/*",
    "http://localhost:3333/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.app.github.dev/*",
        "http://localhost:3333/*"
      ],
      "js": ["selector.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Demo Director",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "veil-1": {
      "suggested_key": { "default": "Ctrl+Shift+1", "mac": "MacCtrl+Shift+1" },
      "description": "Toggle veil 1"
    },
    "veil-2": {
      "suggested_key": { "default": "Ctrl+Shift+2", "mac": "MacCtrl+Shift+2" },
      "description": "Toggle veil 2"
    },
    "veil-3": {
      "suggested_key": { "default": "Ctrl+Shift+3", "mac": "MacCtrl+Shift+3" },
      "description": "Toggle veil 3"
    },
    "reset": {
      "suggested_key": { "default": "Ctrl+Shift+0", "mac": "MacCtrl+Shift+0" },
      "description": "Reset the stage (all veils on)"
    },
    "veil-4": { "description": "Toggle veil 4" },
    "veil-5": { "description": "Toggle veil 5" },
    "veil-6": { "description": "Toggle veil 6" },
    "toggle-mode": { "description": "Switch Rehearse / Live mode" },
    "start-picker": { "description": "Pick an element to veil (Rehearse mode)" }
  }
}
